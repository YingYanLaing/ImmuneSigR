# 加载必要的包
library(readxl)
library(dplyr)
# 读取Excel文件
your_data <- read_excel("D:/Desktop/gmt_p/likegmt0503.xlsx", col_names = FALSE)
# 查看数据结构
print(paste("行数:", nrow(your_data)))
print(paste("列数:", ncol(your_data)))
# 定义修复版的转换函数
write_my_gmt_fixed <- function(data, filename) {
# 打开文件连接
con <- file(filename, "w")
processed_count <- 0
skipped_count <- 0
# 逐行处理数据
for(i in 1:nrow(data)) {
# 获取当前行的所有值，强制转换为字符并去除前后空格
row_values <- trimws(as.character(data[i, ]))
# 更严格的空值检测
row_values <- row_values[!is.na(row_values) &
row_values != "" &
!is.null(row_values) &
row_values != "NA" &
row_values != "NULL"]
# 检查是否为空行
if(length(row_values) == 0) {
skipped_count <- skipped_count + 1
next
}
# 检查前两个元素是否有效（GMT格式要求至少名称和描述）
if(length(row_values) >= 2 &&
nchar(row_values[1]) > 0 &&
nchar(row_values[2]) > 0) {
# 关键修复：移除所有字段中的换行符和制表符
row_values_clean <- gsub("[\r\n\t]", " ", row_values)
# 构建GMT格式行
gmt_line <- paste(row_values_clean, collapse = "\t")
# 写入文件，确保只写一行
writeLines(gmt_line, con)
processed_count <- processed_count + 1
# 调试：如果前几行，打印信息
if(i <= 3) {
print(paste("处理行", i, ":", substr(gmt_line, 1, 50), "..."))
}
} else {
skipped_count <- skipped_count + 1
print(paste("跳过行", i, ": 前两个元素无效"))
}
}
close(con)
return(list(processed = processed_count, skipped = skipped_count))
}
# 执行转换
result <- write_my_gmt_fixed(your_data, "cellmarker_gmt_0513.gmt")
# 打印统计信息
print(paste("原始数据行数:", nrow(your_data)))
print(paste("成功处理行数:", result$processed))
print(paste("跳过的行数:", result$skipped))
# 检查生成的GMT文件
gmt_content <- readLines("cellmarker_gmt_0503.gmt")
# 检查生成的GMT文件
gmt_content <- readLines("cellmarker_gmt_0513.gmt")
print(paste("实际生成的GMT文件行数:", length(gmt_content)))
# 验证行数是否匹配
if(result$processed == length(gmt_content)) {
print("✓ 行数匹配，转换成功！")
} else {
print("⚠ 行数不匹配，可能还有其他问题")
# 进一步调试：检查哪些行可能有问题
print("=== 调试信息 ===")
print(paste("差异:", length(gmt_content) - result$processed, "行"))
# 检查GMT文件的前几行
if(length(gmt_content) > 0) {
print("GMT文件前5行预览:")
for(i in 1:min(5, length(gmt_content))) {
print(paste("行", i, ":", substr(gmt_content[i], 1, 80), "..."))
}
}
}
