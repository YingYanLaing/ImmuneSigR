# 加载必备的数据清洗核心包
library(dplyr)
library(stringr)
# 1. 精准定位你的本地文件路径
# (注意：已将 Windows 的 \ 自动转换为 R 语言安全的 / )
input_path <- "D:/Desktop/gmt_p/aboutCRAN/cellmarker_meta.csv"
# 读取原始数据
data <- read.csv(input_path, stringsAsFactors = FALSE)
# 2. 执行严谨的标准化命名转换 (策略一：显性保留 _OR_ 语义)
data <- data %>%
mutate(
# 步骤 A：转换为纯大写 (MSigDB 规范的第一步)
cell_name = str_to_upper(cell_name),
# 步骤 B：处理生物学正负号 (+ 变 POS, - 变 NEG)
cell_name = str_replace_all(cell_name, "\\+", "POS"),
cell_name = str_replace_all(cell_name, "-", "NEG"),
# 步骤 C：【核心策略】将斜杠明确翻译为 _OR_，彻底消除歧义
cell_name = str_replace_all(cell_name, "/", "_OR_"),
# 步骤 D：将括号和所有空格替换为下划线
cell_name = str_replace_all(cell_name, "[\\(\\)\\s+]", "_"),
# 步骤 E：拼接唯一的 PMID 溯源标识，打造终极唯一 ID
cell_name = paste0(cell_name, "_PMID_", PMID),
# 步骤 F：深度保洁 (将连续的多个下划线压缩成一个，并切除首尾可能多余的下划线)
cell_name = str_replace_all(cell_name, "_+", "_"),
cell_name = str_replace(cell_name, "^_|_$", "")
)
# 3. 打印预览，检查清洗效果
cat("============== 转换结果预览 ==============\n")
print(head(data$cell_name, 5))
cat("==========================================\n")
# 4. 导出为全新的清洗版文件，存放在同一目录下
output_path <- "D:/Desktop/gmt_p/aboutCRAN/cellmarker_meta_MSigDB.csv"
write.csv(data, output_path, row.names = FALSE)
message("✅ 完美通关！规范化数据已成功生成，存放在：\n", output_path)
